---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<Layout title="Project Lazarus | Archival Research Notes">
  <main class="max-w-[68ch] mx-auto px-4 py-24 relative">
    <header class="mb-24 text-center">
      <h1 class="text-4xl font-serif text-inkLight tracking-tight">Project Lazarus</h1>
      <p class="font-mono text-graphiteLight text-sm mt-4 tracking-widest uppercase">Research Notes & Working Papers // The Archival Rabbit Hole</p>
    </header>

    <div class="space-y-16">
      {allPosts.map(post => (
        <article class="group relative">
          <div class="flex items-baseline justify-between border-b border-hairlineDark pb-2 mb-4">
            <time class="font-mono text-graphiteLight text-sm">{post.data.date}</time>
            <span class="font-mono text-graphiteLight text-xs">[{post.data.tag}]</span>
          </div>
          <h2 class="text-2xl font-serif text-inkLight mb-3 leading-snug">
            <a href={`/Project-Lazarus/${post.slug}`} class="hover:text-terracottaDark underline decoration-hairlineDark hover:decoration-terracottaDark underline-offset-4 decoration-1 transition-colors">
              {post.data.title}
            </a>
          </h2>
          {post.data.description && (
            <p class="font-serif text-graphiteLight text-lg leading-relaxed mb-4">
              {post.data.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </main>
</Layout>
