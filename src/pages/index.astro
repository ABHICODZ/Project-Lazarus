---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Project Lazarus | Archival Research Notes">
  <main class="max-w-[68ch] mx-auto px-4 py-24 relative">
    <header class="mb-24 text-center">
      <h1 class="text-4xl font-serif text-inkLight tracking-tight">Project Lazarus</h1>
      <p class="font-mono text-graphiteLight text-sm mt-4 tracking-widest uppercase">Research Notes & Working Papers // The Archival Rabbit Hole</p>
    </header>

    <div class="space-y-16">
      <article class="group relative">
        <div class="flex items-baseline justify-between border-b border-hairlineDark pb-2 mb-4">
          <time class="font-mono text-graphiteLight text-sm">2026.10.04</time>
          <span class="font-mono text-graphiteLight text-xs">[TECH]</span>
        </div>
        <h2 class="text-2xl font-serif text-inkLight mb-3 leading-snug">
          <a href="/new-age-groceries" class="hover:text-terracottaDark underline decoration-hairlineDark hover:decoration-terracottaDark underline-offset-4 decoration-1 transition-colors">
            New Age Groceries
          </a>
        </h2>
        <p class="font-serif text-graphiteLight text-lg leading-relaxed mb-4">
          The beginning of the new era of technology came with a new era of necessity: API access to frontier LLMs...
        </p>
      </article>
    </div>
  </main>
</Layout>
