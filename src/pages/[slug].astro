---
import { render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getPosts, readingTime, related, type Post } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1], more: related(entry, posts) },
  }));
}

interface Props { entry: Post; newer?: Post; older?: Post; more: Post[] }
const { entry, newer, older, more } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout
  frontmatter={{ ...entry.data, readingTime: readingTime(entry.body) }}
  headings={headings}
  newer={newer}
  older={older}
  related={more}
>
  <Content />
</ArticleLayout>
