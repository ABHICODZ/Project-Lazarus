---
import { render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { getPosts, getEntries, readingTime, related, backlinks, ogName, type Post, type Entry } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const all = await getEntries();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1], more: related(entry, all), mentions: backlinks(entry, all) },
  }));
}

interface Props { entry: Post; newer?: Post; older?: Post; more: Entry[]; mentions: Entry[] }
const { entry, newer, older, more, mentions } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout
  ogName={ogName(entry)}
  math={/\$[^$\n]+\$/.test(entry.body ?? '')}
  frontmatter={{ ...entry.data, readingTime: readingTime(entry.body) }}
  headings={headings}
  newer={newer}
  older={older}
  related={more}
  backlinks={mentions}
>
  <Content />
</ArticleLayout>
