---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Lab | Project Lazarus">
  <nav class="max-w-[68ch] mx-auto px-4 pt-12 pb-6 border-b border-hairlineDark mb-12">
    <a href="/Project-Lazarus/" class="font-mono text-sm text-graphiteLight hover:text-terracottaDark transition-colors italic">
      ← Project Lazarus // Index
    </a>
  </nav>

  <main class="max-w-[68ch] mx-auto px-4 pb-24 relative">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-serif text-inkLight leading-tight mb-4">
        The Lab
      </h1>
      <p class="font-mono text-graphiteLight text-sm uppercase tracking-widest">Interactive Experiments & Sketches</p>
    </header>

    <div class="space-y-16">
      <!-- Experiment 1 -->
      <section class="group">
        <h2 class="font-serif text-2xl text-inkLight mb-4 flex items-center gap-3">
          <span class="text-terracottaDark">01.</span> Quantum Lattice
        </h2>
        <p class="font-serif text-graphiteLight mb-6">A lightweight, interactive particle field simulation running on an HTML5 canvas. Hover to exert a repulsive force on the lattice.</p>
        
        <div class="relative w-full h-[400px] border border-hairlineDark bg-[#0a0a0a] overflow-hidden rounded-sm group-hover:border-terracottaDark/30 transition-colors">
          <canvas id="particle-canvas" class="absolute inset-0 w-full h-full"></canvas>
        </div>
      </section>

      <!-- Experiment 2 -->
      <section class="group">
        <h2 class="font-serif text-2xl text-inkLight mb-4 flex items-center gap-3">
          <span class="text-terracottaDark">02.</span> Kinetic Engine
        </h2>
        <p class="font-serif text-graphiteLight mb-6">High-performance text layout and staggered animation. Driven by <a href="https://github.com/chenglou/pretext" class="underline hover:text-terracottaDark" target="_blank">pretext</a> to measure paragraphs without DOM reflows, and <a href="https://animejs.com/" class="underline hover:text-terracottaDark" target="_blank">anime.js</a> for the choreography.</p>
        
        <div class="relative w-full h-[400px] border border-hairlineDark bg-[#0a0a0a] overflow-hidden rounded-sm group-hover:border-terracottaDark/30 transition-colors p-6">
          <button id="trigger-animation" class="absolute top-4 right-4 z-10 px-3 py-1 bg-paperDark border border-terracottaDark text-xs font-mono text-terracottaDark hover:bg-terracottaDark hover:text-inkLight transition-colors cursor-pointer">RUN / RETRY</button>
          
          <div id="text-container" class="font-mono text-sm leading-6 text-graphiteLight w-full h-full relative" data-raw="We used to dream of artificial intelligence taking over the mundane tasks, leaving us free to pursue art and leisure. Instead, the models got so good at mimicking human creativity that we found ourselves doing the data entry and RLHF just to feed them. But there is a silver lining. As the cost of intelligence approaches zero, the friction of manifesting ideas into reality approaches zero. The only remaining bottleneck is human imagination. This text is dynamically laid out calculating exact line breaks using canvas off-thread, completely side-stepping DOM reflow, and then animated absolutely using anime.js.">
            <!-- Text injected via script -->
            Click RUN to execute the layout engine.
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import anime from 'animejs';
  import { prepareWithSegments, layoutWithLines } from '@chenglou/pretext';

  document.addEventListener('astro:page-load', () => {
    // ----------------------------------------------------
    // 01. QUANTUM LATTICE
    // ----------------------------------------------------
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let width = canvas.offsetWidth;
        let height = canvas.offsetHeight;
        canvas.width = width;
        canvas.height = height;
        
        const particles: {x: number, y: number, originX: number, originY: number, vx: number, vy: number}[] = [];
        const cols = Math.floor(width / 30);
        const rows = Math.floor(height / 30);
        
        for(let i=0; i<cols; i++) {
          for(let j=0; j<rows; j++) {
            particles.push({
              x: i * 30 + 15,
              y: j * 30 + 15,
              originX: i * 30 + 15,
              originY: j * 30 + 15,
              vx: 0,
              vy: 0
            });
          }
        }
        
        let mouse = { x: -1000, y: -1000 };
        canvas.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
        });
        canvas.addEventListener('mouseleave', () => {
          mouse.x = -1000;
          mouse.y = -1000;
        });
        
        function animateLattice() {
          if(!ctx) return;
          ctx.clearRect(0, 0, width, height);
          ctx.fillStyle = '#C85A48';
          
          for(let p of particles) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 100) {
              const angle = Math.atan2(dy, dx);
              const force = (100 - dist) * 0.05;
              p.vx -= Math.cos(angle) * force;
              p.vy -= Math.sin(angle) * force;
            }
            p.vx += (p.originX - p.x) * 0.05;
            p.vy += (p.originY - p.y) * 0.05;
            p.vx *= 0.8;
            p.vy *= 0.8;
            p.x += p.vx;
            p.y += p.vy;
            
            ctx.beginPath();
            ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.strokeStyle = 'rgba(200, 90, 72, 0.15)';
            ctx.beginPath();
            ctx.moveTo(p.originX, p.originY);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
          requestAnimationFrame(animateLattice);
        }
        animateLattice();
        window.addEventListener('resize', () => {
          if(canvas.offsetWidth !== width) {
            width = canvas.offsetWidth;
            height = canvas.offsetHeight;
            canvas.width = width;
            canvas.height = height;
          }
        });
      }
    }

    // ----------------------------------------------------
    // 02. KINETIC ENGINE (Pretext + AnimeJS)
    // ----------------------------------------------------
    const container = document.getElementById('text-container');
    const btn = document.getElementById('trigger-animation');
    
    if(container && btn) {
      const rawText = container.getAttribute('data-raw') || '';
      const fontStr = "14px 'Courier Prime', monospace"; 
      
      // Wait for fonts to load so Pretext Canvas measurement is 100% accurate
      document.fonts.ready.then(() => {
        let prepared: any = null;
        try {
           prepared = prepareWithSegments(rawText, fontStr);
        } catch (e) {
           console.warn("Pretext failed", e);
        }
        
        const runAnim = () => {
          if (!prepared) return;
          
          // Measure real width of container minus padding (p-6 = 24px * 2)
          const maxWidth = container.clientWidth - 48;
          const lineHeight = 24; 
          
          // 1. High perf line measuring off-DOM
          const { lines } = layoutWithLines(prepared, maxWidth, lineHeight);
          
          container.innerHTML = '';
          
          // 2. Build DOM layout absolutely, split into characters
          lines.forEach((line, lineIdx) => {
            const lineEl = document.createElement('div');
            lineEl.className = 'absolute left-6 whitespace-pre font-mono text-sm leading-6';
            lineEl.style.top = `${24 + (lineIdx * lineHeight)}px`;
            
            line.text.split('').forEach((char) => {
              const span = document.createElement('span');
              span.innerHTML = char === ' ' ? '&nbsp;' : char;
              span.className = 'k-char inline-block opacity-0';
              
              // Pre-scatter the characters randomly across the box
              const rx = (Math.random() - 0.5) * 800;
              const ry = (Math.random() - 0.5) * 800;
              const rz = (Math.random() - 0.5) * 720;
              span.style.transform = `translate(${rx}px, ${ry}px) rotate(${rz}deg) scale(4)`;
              span.style.color = '#C85A48'; // Start Terracotta
              
              lineEl.appendChild(span);
            });
            
            container.appendChild(lineEl);
          });
          
          // 3. Spectacular Anime.js swarm animation
          anime.timeline()
            .add({
              targets: '.k-char',
              opacity: [0, 1],
              translateX: 0,
              translateY: 0,
              rotate: 0,
              scale: 1,
              color: '#8a8a8a', // Settle into graphite
              delay: anime.stagger(5, {start: 100, from: 'center'}), // Ripple from center
              easing: 'easeOutElastic(1, .6)',
              duration: 1800
            });
        };
        
        btn.addEventListener('click', runAnim);
        
        // Auto-run once when it scrolls into view so the user doesn't miss it
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            runAnim();
            observer.disconnect();
          }
        });
        observer.observe(container);
      });
    }
  });
</script>
