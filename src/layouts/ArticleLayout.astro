---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-terracottaDark z-50 transition-all duration-150" style="width: 0%"></div>
  <script>
    document.addEventListener('astro:page-load', () => {
      const progressBar = document.getElementById('progress-bar');
      if(!progressBar) return;
      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        progressBar.style.width = scrolled + '%';
      });
    });
  </script>

  <nav class="max-w-[68ch] mx-auto px-4 pt-12 pb-6 border-b border-hairlineDark mb-12">
    <a href="/Project-Lazarus/" class="font-mono text-sm text-graphiteLight hover:text-terracottaDark transition-colors italic">
      ← Project Lazarus // Index
    </a>
  </nav>
  
  <article class="max-w-[68ch] mx-auto px-4 pb-24 relative">
    <header class="mb-16">
      <div class="flex items-baseline justify-between mb-4">
        <span class="font-mono text-graphiteLight text-xs tracking-widest uppercase">[{frontmatter.tag}]</span>
        <div class="flex gap-4">
          {frontmatter.readingTime && <span class="font-mono text-graphiteLight text-sm italic">{frontmatter.readingTime}</span>}
          <span class="font-mono text-graphiteLight text-sm">{frontmatter.date}</span>
        </div>
      </div>
      <h1 class="text-4xl md:text-5xl font-serif text-inkLight leading-tight">
        {frontmatter.title}
      </h1>
    </header>
    
    <div class="font-serif text-lg leading-relaxed text-inkLight space-y-6">
      <slot />
    </div>
  </article>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const blocks = document.querySelectorAll('pre');
    blocks.forEach((block) => {
      if (block.querySelector('.copy-btn')) return; // Avoid duplicates on view transition
      
      const button = document.createElement('button');
      button.className = "copy-btn absolute top-2 right-2 text-xs font-mono text-graphiteLight bg-paperDark border border-hairlineDark px-2 py-1 hover:text-inkLight hover:border-terracottaDark transition-colors";
      button.innerText = "COPY";
      
      block.style.position = "relative";
      block.appendChild(button);
      
      button.addEventListener('click', async () => {
        // Find code content, excluding the button's own text
        const code = block.querySelector('code')?.innerText || block.innerText.replace('COPY', '').replace('COPIED', '');
        await navigator.clipboard.writeText(code.trim());
        
        button.innerText = "COPIED";
        button.classList.add("text-terracottaDark", "border-terracottaDark");
        
        setTimeout(() => {
          button.innerText = "COPY";
          button.classList.remove("text-terracottaDark", "border-terracottaDark");
        }, 2000);
      });
    });
  });
</script>
