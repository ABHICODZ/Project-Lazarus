---
import { ViewTransitions } from 'astro:transitions';

interface Props { 
  title: string;
  description?: string;
  image?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description = "Research Notes & Working Papers", image = `${base}/bg.jpg` } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Project Lazarus" href={`${base}/rss.xml`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <ViewTransitions />
    <!-- Restoring the Archival Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-paperDark text-inkLight min-h-screen antialiased selection:bg-[#333333]">
    <!-- Custom AI-Generated Dark Archival Background -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.25] bg-cover bg-center bg-fixed z-0 mix-blend-screen" style={`background-image:url(${base}/bg.jpg)`}></div>
    
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
