---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/400-italic.css';
import '@fontsource/courier-prime/700.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, description = 'Research Notes & Working Papers', image = `${base}/og/default.png`, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Project Lazarus" href={`${base}/rss.xml`} />
    <link rel="alternate" type="application/feed+json" title="Project Lazarus" href={`${base}/feed.json`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Set the theme before first paint so there is no dark→light flash -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-paperDark text-inkLight min-h-screen antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <div
      aria-hidden="true"
      class="fixed inset-0 pointer-events-none bg-cover bg-center bg-fixed z-0"
      style={`background-image:url(${base}/bg.jpg);opacity:var(--bg-opacity);mix-blend-mode:var(--bg-blend)`}
    ></div>

    <button id="theme-toggle" type="button" transition:persist aria-label="Toggle light and dark theme"
      class="fixed top-4 right-4 z-50 font-mono text-xs px-2 py-1 border border-hairlineDark bg-paperDark/80 text-graphiteLight hover:text-terracottaDark hover:border-terracottaDark transition-colors cursor-pointer">
      THEME
    </button>

    <div class="relative z-10" id="main">
      <slot />
    </div>
  </body>
</html>

<script>
  const apply = (t: string) => {
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem('theme', t); } catch {}
  };
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('#theme-toggle')) return;
    apply(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
  });
  // The new document after a view transition starts from the server-rendered default; re-apply.
  document.addEventListener('astro:after-swap', () => {
    let t: string | null = null;
    try { t = localStorage.getItem('theme'); } catch {}
    if (t) document.documentElement.dataset.theme = t;
  });
</script>
