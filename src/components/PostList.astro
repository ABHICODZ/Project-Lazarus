---
import { base, slugify } from '../utils/date';
import type { Post } from '../utils/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<div class="space-y-16">
  {posts.map((post) => (
    <article class="group relative">
      <div class="flex items-baseline justify-between border-b border-hairlineDark pb-2 mb-4">
        <time class="font-mono text-graphiteLight text-sm">{post.data.date}</time>
        <a href={`${base}tag/${slugify(post.data.tag)}/`} class="font-mono text-graphiteLight hover:text-terracottaDark text-xs">[{post.data.tag}]</a>
      </div>
      <h2 class="text-2xl font-serif text-inkLight mb-3 leading-snug">
        <a href={`${base}${post.id}/`} class="hover:text-terracottaDark underline decoration-hairlineDark hover:decoration-terracottaDark underline-offset-4 decoration-1 transition-colors">
          {post.data.title}
        </a>
      </h2>
      {post.data.description && (
        <p class="font-serif text-graphiteLight text-lg leading-relaxed">{post.data.description}</p>
      )}
    </article>
  ))}
</div>
