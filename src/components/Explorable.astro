---
import { REPO, BRANCH } from '../config';

interface Props {
  title: string;
  /** Repo-relative path of the component, for the "View source" link. */
  source?: string;
  /** Short caption such as "Fig. 2". */
  num?: number | string;
}
const { title, source, num } = Astro.props;
const hasNotes = Astro.slots.has('notes');
const hasFallback = Astro.slots.has('fallback');
---
<figure class="explorable not-prose my-12 -mx-4 md:-mx-12 border border-hairlineDark bg-[rgb(var(--well))]" data-explorable>
  <figcaption class="flex items-baseline justify-between gap-4 px-4 py-3 border-b border-hairlineDark font-mono text-xs">
    <span class="text-terracottaDark uppercase tracking-widest">{num ? `Explorable ${num}` : 'Explorable'}</span>
    <span class="text-graphiteLight text-right">{title}</span>
  </figcaption>

  <div class="p-4 md:p-6" data-explorable-body><slot /></div>
  {hasFallback && <noscript><div class="p-4 text-sm font-mono text-graphiteLight"><slot name="fallback" /></div></noscript>}

  {hasNotes && (
    <details class="border-t border-hairlineDark px-4 py-3 text-sm font-serif text-graphiteLight">
      <summary class="font-mono text-xs uppercase tracking-widest cursor-pointer text-graphiteLight hover:text-terracottaDark">Model notes</summary>
      <div class="mt-3 space-y-2 leading-relaxed"><slot name="notes" /></div>
    </details>
  )}

  <div class="flex flex-wrap gap-4 px-4 py-3 border-t border-hairlineDark font-mono text-xs">
    <button type="button" data-share class="text-graphiteLight hover:text-terracottaDark cursor-pointer">Copy link to this state</button>
    {source && <a href={`https://github.com/${REPO}/blob/${BRANCH}/${source}`} rel="noopener" class="text-graphiteLight hover:text-terracottaDark">View source</a>}
    <span data-share-status class="text-graphiteLight" role="status"></span>
  </div>
</figure>

<script>
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('[data-share]');
    if (!btn) return;
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-share-status]');
    try {
      await navigator.clipboard.writeText(location.href);
      if (status) status.textContent = 'Copied.';
    } catch {
      if (status) status.textContent = 'Copy the address bar instead.';
    }
    setTimeout(() => status && (status.textContent = ''), 2000);
  });
</script>
