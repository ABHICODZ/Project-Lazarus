---
import { base } from '../utils/date';
---
<!--
  Pagefind builds its UI bundle into dist/pagefind/ after `astro build` (see the postbuild script),
  so it does not exist under `astro dev`. The trigger just renders nothing there.
-->
<link rel="stylesheet" href={`${base}pagefind/pagefind-component-ui.css`} />
<script is:inline type="module" src={`${base}pagefind/pagefind-component-ui.js`}></script>
<pagefind-config bundle-path={`${base}pagefind/`}></pagefind-config>
<pagefind-modal-trigger></pagefind-modal-trigger>
<pagefind-modal></pagefind-modal>

<style is:global>
  /* Map Pagefind's tokens onto the site theme so search follows light and dark. */
  :root, pagefind-modal, pagefind-modal-trigger {
    --pf-background: rgb(var(--paper));
    --pf-text: rgb(var(--ink));
    --pf-text-secondary: rgb(var(--graphite));
    --pf-text-muted: rgb(var(--graphite));
    --pf-border: rgb(var(--control));
    --pf-border-focus: rgb(var(--accent));
    --pf-outline-focus: rgb(var(--accent));
    --pf-hover: rgb(var(--well));
    --pf-mark: rgb(var(--accent) / 0.3);
    --pf-font: var(--font-serif);
    --pf-border-radius: 2px;
  }
</style>
