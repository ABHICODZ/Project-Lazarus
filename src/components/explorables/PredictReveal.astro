---
interface Props {
  question: string;
  options: string[];
  /** Index of the correct option. */
  answer: number;
}
const { question, options, answer } = Astro.props;
---
<fieldset class="predict not-prose my-10 border border-hairlineDark border-l-2 border-l-terracottaDark bg-[rgb(var(--well))] p-5" data-predict data-answer={answer}>
  <legend class="px-2 font-mono text-xs uppercase tracking-widest text-terracottaDark">Predict first</legend>
  <p class="font-serif text-lg mb-4">{question}</p>
  <div class="flex flex-wrap gap-3">
    {options.map((o, i) => (
      <button type="button" data-choice={i} class="px-4 py-2 border border-controlDark font-mono text-sm text-graphiteLight hover:text-terracottaDark hover:border-terracottaDark aria-pressed:border-terracottaDark aria-pressed:text-terracottaDark transition-colors cursor-pointer" aria-pressed="false">{o}</button>
    ))}
  </div>
  <p data-verdict role="status" class="mt-4 font-mono text-sm"></p>
  <div data-reveal hidden class="mt-3 font-serif text-base leading-relaxed text-graphiteLight"><slot /></div>
</fieldset>

<script>
  function init(box: HTMLElement) {
    if (box.dataset.ready) return;
    box.dataset.ready = '1';
    const answer = Number(box.dataset.answer);
    const verdict = box.querySelector<HTMLElement>('[data-verdict]')!;
    const reveal = box.querySelector<HTMLElement>('[data-reveal]')!;
    const buttons = [...box.querySelectorAll<HTMLButtonElement>('[data-choice]')];
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const pick = Number(b.dataset.choice);
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        verdict.textContent = pick === answer ? 'Right. Here is why.' : `Not quite: the answer is "${buttons[answer].textContent}".`;
        reveal.hidden = false;
      });
    }
  }
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-predict]').forEach(init));
</script>
